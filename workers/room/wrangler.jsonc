{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tpkn-room",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "development",
  },
  "env": {
    "development": {
      "name": "tpkn-room-development",
      "vars": {
        "APP_ENV": "development",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "ROOMS",
            "class_name": "Room",
          },
        ],
      },
    },
    "staging": {
      "name": "tpkn-room-staging",
      "vars": {
        "APP_ENV": "staging",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "ROOMS",
            "class_name": "Room",
          },
        ],
      },
    },
    "production": {
      "name": "tpkn-room-production",
      "vars": {
        "APP_ENV": "production",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "ROOMS",
            "class_name": "Room",
          },
        ],
      },
    },
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"],
    },
  ],
}
