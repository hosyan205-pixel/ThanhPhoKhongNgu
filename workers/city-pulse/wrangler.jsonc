{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tpkn-city-pulse",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "development",
  },
  "env": {
    "development": {
      "name": "tpkn-city-pulse-development",
      "vars": {
        "APP_ENV": "development",
      },
    },
    "staging": {
      "name": "tpkn-city-pulse-staging",
      "vars": {
        "APP_ENV": "staging",
      },
    },
    "production": {
      "name": "tpkn-city-pulse-production",
      "vars": {
        "APP_ENV": "production",
      },
    },
  },
}
